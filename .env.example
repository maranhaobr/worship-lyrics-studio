DATABASE_URL="postgresql://wls:wls@localhost:5433/wls?schema=public"
# Produção: origem HTTPS exata da aplicação (sem caminho), obrigatória para autenticação.
# APP_ORIGIN="https://studio.suaigreja.com.br"
# Envio de confirmação e recuperação. Produção exige SMTP e APP_ORIGIN HTTPS.
# Desenvolvimento: file salva mensagens privadas em .data/mail (não envia e-mail).
# MAIL_TRANSPORT="file"
# MAIL_TRANSPORT="smtp"
# MAIL_FROM="Worship Lyrics Studio <nao-responda@seudominio.com.br>"
# SMTP_HOST="smtp.seuprovedor.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="seu-usuario"
# SMTP_PASSWORD="configure-apenas-no-ambiente"
# SMTP_REQUIRE_TLS="true"
# Opcional: diretório absoluto para mídia persistente. Sem esta variável,
# o servidor iniciado por npm run dev usa .data/media na raiz do repositório.
# MEDIA_STORAGE_DIR="C:/Projetos/worship-lyrics-studio/.data/media"
# O worker usa o mesmo diretório, montado somente para leitura pelo Docker Compose.
# Iniciar: docker compose --profile alignment up -d --build alignment-worker
