generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum SectionType {
  INTRO
  VERSE
  PRE_CHORUS
  CHORUS
  BRIDGE
  OUTRO
  CUSTOM
}
model Song {
  id        String        @id @default(cuid())
  title     String
  artist    String?
  key       String?
  bpm       Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sections  SongSection[]
  visualProjects VisualProject[]
  @@index([title])
}
model SongSection {
  id        String      @id @default(cuid())
  songId    String
  song      Song        @relation(fields: [songId], references: [id], onDelete: Cascade)
  type      SectionType
  label     String
  order     Int
  lines     LyricLine[]
  @@unique([songId, order])
}
model LyricLine {
  id        String      @id @default(cuid())
  sectionId String
  section   SongSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text      String
  order     Int
  startMs   Int?
  endMs     Int?
  @@unique([sectionId, order])
}

model VisualProject {
  id        String   @id @default(cuid())
  songId    String?
  song      Song?    @relation(fields: [songId], references: [id], onDelete: SetNull)
  name      String
  revision  Int      @default(1)
  document  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  alignmentJobs AlignmentJob[]
  @@index([songId, updatedAt])
}

model VisualTemplate {
  id        String   @id @default(cuid())
  name      String
  style     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  name       String
  kind       String
  mimeType   String
  storageKey String   @unique
  size       Int
  durationMs Int?
  createdAt  DateTime @default(now())
  alignmentJobs AlignmentJob[]
}

enum AlignmentStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  APPLIED
  CANCELLED
}

model AlignmentJob {
  id           String @id @default(cuid())
  projectId    String
  project      VisualProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audioAssetId String
  audioAsset   MediaAsset @relation(fields: [audioAssetId], references: [id], onDelete: Restrict)
  status       AlignmentStatus @default(QUEUED)
  document     Json
  result       Json?
  progress     Int @default(0)
  attempts     Int @default(0)
  leaseToken   String?
  heartbeatAt  DateTime?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([status, createdAt])
  @@index([projectId, createdAt])
}

model AlignmentWorker {
  id        String @id
  updatedAt DateTime @default(now())
}
